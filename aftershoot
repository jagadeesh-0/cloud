      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.preprocessing import OrdinalEncoder\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from lightgbm import LGBMRegressor\n"
      ],
      "metadata": {
        "id": "umlReknCDg3U"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "train = pd.read_csv('/content/dataset/train/sliders.csv')\n",
        "valid = pd.read_csv('/content/dataset/sliders_input.csv')"
      ],
      "metadata": {
        "id": "fjI7MxCfDmWS"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Targets to predict\n",
        "y_temp = train['Temperature']\n",
        "y_tint = train['Tint']\n",
        "\n",
        "# Drop targets from input\n",
        "X = train.drop(columns=['Temperature', 'Tint'])\n"
      ],
      "metadata": {
        "id": "5nBLV4evHgQo"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "num_cols = X.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
        "cat_cols = X.select_dtypes(include=['object']).columns.tolist()\n",
        "\n",
        "print(\"Numeric columns:\", num_cols)\n",
        "print(\"Categorical columns:\", cat_cols)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Tgq50MzZHi7c",
        "outputId": "88b6108e-aa8f-4a9d-b6ce-e1b6035716a4"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Numeric columns: ['copyCreationTime', 'touchTime', 'grayscale', 'aperture', 'flashFired', 'focalLength', 'isoSpeedRating', 'shutterSpeed', 'currTemp', 'currTint']\n",
            "Categorical columns: ['captureTime', 'id_global']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.preprocessing import OrdinalEncoder\n",
        "\n",
        "preprocessor = ColumnTransformer([\n",
        "    ('categorical', OrdinalEncoder(handle_unknown='use_encoded_value', unknown_value=-1), cat_cols),\n",
        "    ('numerical', 'passthrough', num_cols)\n",
        "])\n"
      ],
      "metadata": {
        "id": "WQ_l_EEHHme3"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "model_temp = Pipeline([\n",
        "    ('pre', preprocessor),\n",
        "    ('regressor', LGBMRegressor(\n",
        "        n_estimators=1200,\n",
        "        learning_rate=0.03,\n",
        "        num_leaves=63,\n",
        "        random_state=42\n",
        "    ))\n",
        "])\n",
        "\n",
        "model_tint = Pipeline([\n",
        "    ('pre', preprocessor),\n",
        "    ('regressor', LGBMRegressor(\n",
        "        n_estimators=800,\n",
        "        learning_rate=0.05,\n",
        "        num_leaves=63,\n",
        "        random_state=42\n",
        "    ))\n",
        "])\n",
        "\n",
        "# Train both models on all available data\n",
        "model_temp.fit(X, y_temp)\n",
        "model_tint.fit(X, y_tint)\n"
      ],
